{
  "expo": {
    "name": "NAVI-VICA",
    "slug": "navi-vica",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "navi-vica",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "VICA uses the camera to tell you what is around you.",
        "NSMicrophoneUsageDescription": "VICA listens so you can talk to her hands-free.",
        "NSPhotoLibraryUsageDescription": "Analyze photos for scene description",
        "NSLocationWhenInUseUsageDescription": "VICA guides you and shares your location in an emergency.",
        "NSBluetoothAlwaysUsageDescription": "VICA connects to your pulse bracelet and blood-pressure cuff.",
        "NSMotionUsageDescription": "VICA notices a fall and checks that you are okay."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0f0f1e"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "CALL_PHONE",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "RECORD_AUDIO",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f0f1e"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NAVI-VICA to access your camera for scene analysis"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow NAVI-VICA to access your microphone for voice commands"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00D9FF"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}