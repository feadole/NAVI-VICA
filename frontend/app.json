{
  "expo": {
    "name": "NAVI-VICA",
    "slug": "navi-vica",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "navi-vica",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan surroundings for navigation assistance",
        "NSMicrophoneUsageDescription": "Voice commands for hands-free control",
        "NSPhotoLibraryUsageDescription": "Analyze photos for scene description"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0f0f1e"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f0f1e"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NAVI-VICA to access your camera for scene analysis"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow NAVI-VICA to access your microphone for voice commands"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00D9FF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
